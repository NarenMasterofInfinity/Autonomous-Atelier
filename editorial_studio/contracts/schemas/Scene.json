    "MaskLayer": {
      "additionalProperties": false,
      "properties": {
        "blend_mode": {
          "$ref": "#/$defs/BlendMode",
          "default": "normal"
        },
        "bounds": {
          "$ref": "#/$defs/BoundsMM"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "invert": {
          "default": false,
          "title": "Invert",
          "type": "boolean"
