  "additionalProperties": false,
  "properties": {
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "design_language_id": {
      "title": "Design Language Id",
      "type": "string"
    },
    "height_mm": {
      "exclusiveMinimum": 0,
      "title": "Height Mm",
      "type": "number"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "layers": {
      "items": {
        "discriminator": {
          "mapping": {
            "group": "#/$defs/GroupLayer",
            "image": "#/$defs/ImageLayer",
            "mask": "#/$defs/MaskLayer",
            "text": "#/$defs/TextLayer",
            "vector": "#/$defs/VectorLayer"
          },
          "propertyName": "layer_type"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/ImageLayer"
          },
          {
            "$ref": "#/$defs/TextLayer"
          },
          {
            "$ref": "#/$defs/VectorLayer"
          },
          {
            "$ref": "#/$defs/MaskLayer"
          },
          {
            "$ref": "#/$defs/GroupLayer"
          }
        ]
