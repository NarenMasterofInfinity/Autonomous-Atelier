          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effective Ppi"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "layer_type": {
          "const": "image",
          "default": "image",
          "title": "Layer Type",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "opacity": {
          "default": 1.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Opacity",
          "type": "number"
        },
        "owner_skill_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Owner Skill Id"
        },
        "semantic_role": {
          "title": "Semantic Role",
          "type": "string"
        },
        "visible": {
          "default": true,
          "title": "Visible",
          "type": "boolean"
        },
        "z_index": {
          "title": "Z Index",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "name",
        "semantic_role",
        "z_index",
        "bounds",
        "asset_id"
      ],
      "title": "ImageLayer",
      "type": "object"
