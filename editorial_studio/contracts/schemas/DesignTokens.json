{
  "$defs": {
    "GridSpec": {
      "additionalProperties": false,
      "properties": {
        "baseline_origin_mm": {
          "default": 20,
          "minimum": 0,
          "title": "Baseline Origin Mm",
          "type": "number"
        },
        "baseline_step_mm": {
          "default": 5,
          "exclusiveMinimum": 0,
          "title": "Baseline Step Mm",
          "type": "number"
        },
        "baseline_tolerance_mm": {
          "default": 0.01,
          "exclusiveMinimum": 0,
          "maximum": 0.05,
          "title": "Baseline Tolerance Mm",
          "type": "number"
        },
        "bottom_margin_mm": {
          "default": 20,
          "minimum": 0,
          "title": "Bottom Margin Mm",
          "type": "number"
        },
        "column_gap_mm": {
          "default": 6,
          "minimum": 0,
          "title": "Column Gap Mm",
          "type": "number"
        },
        "columns_per_page": {
          "default": 3,
          "maximum": 12,
          "minimum": 1,
          "title": "Columns Per Page",
          "type": "integer"
        },
        "fold_safe_mm": {
          "default": 10,
          "minimum": 0,
          "title": "Fold Safe Mm",
          "type": "number"
        },
        "height_mm": {
          "default": 297,
          "exclusiveMinimum": 0,
          "title": "Height Mm",
          "type": "number"
        },
        "outer_margin_mm": {
          "default": 20,
          "minimum": 0,
          "title": "Outer Margin Mm",
          "type": "number"
        },
        "page_width_mm": {
          "default": 210,
          "exclusiveMinimum": 0,
          "title": "Page Width Mm",
          "type": "number"
        },
        "top_margin_mm": {
          "default": 20,
          "minimum": 0,
          "title": "Top Margin Mm",
          "type": "number"
        },
        "width_mm": {
          "default": 420,
          "exclusiveMinimum": 0,
          "title": "Width Mm",
          "type": "number"
        }
      },
      "title": "GridSpec",
      "type": "object"
    },
    "ModularTypeScale": {
      "additionalProperties": false,
      "properties": {
        "body_pt": {
          "maximum": 16,
          "minimum": 9,
          "title": "Body Pt",
          "type": "number"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "ratio": {
          "exclusiveMinimum": 1,
          "maximum": 2,
          "title": "Ratio",
          "type": "number"
        },
        "role_steps": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Role Steps",
          "type": "object"
        }
      },
      "required": [
        "id",
        "body_pt",
        "ratio",
        "role_steps"
      ],
      "title": "ModularTypeScale",
      "type": "object"
    },
    "PaletteToken": {
      "additionalProperties": false,
      "properties": {
        "hex_color": {
          "pattern": "^#[0-9a-fA-F]{6}$",
          "title": "Hex Color",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "name",
        "hex_color"
      ],
      "title": "PaletteToken",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "body_span_columns": {
      "default": 2,
      "minimum": 1,
      "title": "Body Span Columns",
      "type": "integer"
    },
    "grid": {
      "$ref": "#/$defs/GridSpec"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "minimum_body_pt": {
      "maximum": 16,
      "minimum": 9,
      "title": "Minimum Body Pt",
      "type": "number"
    },
    "palette": {
      "items": {
        "$ref": "#/$defs/PaletteToken"
      },
      "title": "Palette",
      "type": "array"
    },
    "prefer_paragraph_breaks": {
      "default": false,
      "title": "Prefer Paragraph Breaks",
      "type": "boolean"
    },
    "rule_width_mm": {
      "exclusiveMinimum": 0,
      "maximum": 2,
      "title": "Rule Width Mm",
      "type": "number"
    },
    "type_scale": {
      "$ref": "#/$defs/ModularTypeScale"
    },
    "version": {
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "id",
    "version",
    "grid",
    "type_scale",
    "palette",
    "rule_width_mm",
    "minimum_body_pt"
  ],
  "title": "DesignTokens",
  "type": "object"
}
