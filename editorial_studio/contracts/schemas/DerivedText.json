        "excerpt",
        "condensed",
        "paraphrase",
        "new_copy"
      ],
      "title": "EditType",
      "type": "string"
    },
    "SourceSpan": {
      "additionalProperties": false,
      "properties": {
        "end_char": {
          "exclusiveMinimum": 0,
          "title": "End Char",
          "type": "integer"
        },
        "source_block_id": {
          "title": "Source Block Id",
          "type": "string"
        },
        "source_revision_id": {
          "title": "Source Revision Id",
          "type": "string"
        },
        "start_char": {
          "minimum": 0,
          "title": "Start Char",
          "type": "integer"
