    "id": {
      "title": "Id",
      "type": "string"
    },
    "placed_layer_ids": {
      "items": {
        "type": "string"
      },
      "title": "Placed Layer Ids",
      "type": "array"
    },
    "text": {
      "title": "Text",
      "type": "string"
    }
  },
  "required": [
