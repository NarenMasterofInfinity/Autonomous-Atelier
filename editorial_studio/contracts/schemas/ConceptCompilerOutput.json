        "mask_asset_id": {
          "title": "Mask Asset Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "opacity": {
          "default": 1.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Opacity",
          "type": "number"
