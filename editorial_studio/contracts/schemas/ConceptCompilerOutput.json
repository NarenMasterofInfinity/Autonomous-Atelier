    "MoveTo": {
      "additionalProperties": false,
      "properties": {
        "cmd": {
          "const": "M",
          "default": "M",
          "title": "Cmd",
          "type": "string"
        },
        "p": {
          "$ref": "#/$defs/PointMM"
        }
      },
      "required": [
        "p"
      ],
      "title": "MoveTo",
      "type": "object"
    },
    "PathGeometry": {
      "additionalProperties": false,
      "properties": {
        "commands": {
          "items": {
            "discriminator": {
              "mapping": {
                "C": "#/$defs/CubicTo",
                "L": "#/$defs/LineTo",
                "M": "#/$defs/MoveTo",
                "Q": "#/$defs/QuadraticTo",
                "Z": "#/$defs/ClosePath"
              },
              "propertyName": "cmd"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/MoveTo"
              },
              {
                "$ref": "#/$defs/LineTo"
              },
              {
                "$ref": "#/$defs/QuadraticTo"
              },
              {
                "$ref": "#/$defs/CubicTo"
              },
              {
                "$ref": "#/$defs/ClosePath"
              }
            ]
          },
          "minItems": 2,
          "title": "Commands",
          "type": "array"
        },
        "fill_rule": {
          "default": "nonzero",
          "enum": [
            "nonzero",
            "evenodd"
          ],
          "title": "Fill Rule",
          "type": "string"
        }
      },
      "required": [
        "commands"
      ],
      "title": "PathGeometry",
      "type": "object"
    },
    "PointMM": {
      "additionalProperties": false,
      "properties": {
        "x_mm": {
          "title": "X Mm",
          "type": "number"
        },
        "y_mm": {
          "title": "Y Mm",
          "type": "number"
        }
      },
      "required": [
        "x_mm",
        "y_mm"
      ],
      "title": "PointMM",
      "type": "object"
    },
    "QuadraticTo": {
      "additionalProperties": false,
      "properties": {
        "cmd": {
          "const": "Q",
          "default": "Q",
          "title": "Cmd",
          "type": "string"
        },
        "control": {
          "$ref": "#/$defs/PointMM"
        },
        "p": {
          "$ref": "#/$defs/PointMM"
        }
      },
      "required": [
        "control",
        "p"
      ],
      "title": "QuadraticTo",
      "type": "object"
    },
    "Scene": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "design_language_id": {
          "title": "Design Language Id",
          "type": "string"
        },
        "height_mm": {
          "exclusiveMinimum": 0,
          "title": "Height Mm",
          "type": "number"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "layers": {
          "items": {
            "discriminator": {
              "mapping": {
                "group": "#/$defs/GroupLayer",
                "image": "#/$defs/ImageLayer",
                "mask": "#/$defs/MaskLayer",
                "text": "#/$defs/TextLayer",
                "vector": "#/$defs/VectorLayer"
              },
              "propertyName": "layer_type"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/ImageLayer"
              },
              {
                "$ref": "#/$defs/TextLayer"
              },
              {
                "$ref": "#/$defs/VectorLayer"
              },
              {
                "$ref": "#/$defs/MaskLayer"
              },
              {
                "$ref": "#/$defs/GroupLayer"
              }
            ]
          },
          "title": "Layers",
          "type": "array"
        },
        "parent_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Version"
        },
        "spread_id": {
          "title": "Spread Id",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        },
        "width_mm": {
          "exclusiveMinimum": 0,
          "title": "Width Mm",
          "type": "number"
        }
      },
      "required": [
        "id",
        "spread_id",
        "version",
        "width_mm",
        "height_mm",
        "design_language_id",
        "created_at"
      ],
      "title": "Scene",
      "type": "object"
    },
