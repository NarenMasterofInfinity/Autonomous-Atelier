            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effective Ppi"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "layer_type": {
          "const": "image",
          "default": "image",
          "title": "Layer Type",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "opacity": {
          "default": 1.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Opacity",
          "type": "number"
        },
        "owner_skill_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Owner Skill Id"
        },
        "semantic_role": {
          "title": "Semantic Role",
          "type": "string"
        },
        "visible": {
          "default": true,
          "title": "Visible",
          "type": "boolean"
        },
        "z_index": {
          "title": "Z Index",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "name",
        "semantic_role",
        "z_index",
        "bounds",
        "asset_id"
      ],
      "title": "ImageLayer",
      "type": "object"
    },
    "LineTo": {
      "additionalProperties": false,
      "properties": {
        "cmd": {
          "const": "L",
          "default": "L",
          "title": "Cmd",
          "type": "string"
        },
        "p": {
          "$ref": "#/$defs/PointMM"
        }
      },
      "required": [
        "p"
      ],
      "title": "LineTo",
      "type": "object"
    },
    "MaskLayer": {
      "additionalProperties": false,
      "properties": {
        "blend_mode": {
          "$ref": "#/$defs/BlendMode",
          "default": "normal"
        },
        "bounds": {
          "$ref": "#/$defs/BoundsMM"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "invert": {
          "default": false,
          "title": "Invert",
          "type": "boolean"
        },
        "layer_type": {
          "const": "mask",
          "default": "mask",
          "title": "Layer Type",
          "type": "string"
