      "required": [
        "id",
        "name",
        "semantic_role",
        "z_index",
        "bounds",
        "text_content",
        "style_name"
      ],
      "title": "TextLayer",
      "type": "object"
    },
    "UnsupportedFeature": {
      "additionalProperties": false,
