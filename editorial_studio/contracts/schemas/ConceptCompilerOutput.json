{
  "$defs": {
    "BlendMode": {
      "enum": [
        "normal",
        "multiply",
        "screen",
        "overlay",
        "darken",
        "lighten"
      ],
      "title": "BlendMode",
      "type": "string"
    },
    "BoundsMM": {
      "additionalProperties": false,
      "properties": {
        "height_mm": {
          "exclusiveMinimum": 0,
          "title": "Height Mm",
          "type": "number"
        },
        "width_mm": {
          "exclusiveMinimum": 0,
          "title": "Width Mm",
          "type": "number"
        },
        "x_mm": {
          "title": "X Mm",
          "type": "number"
        },
        "y_mm": {
          "title": "Y Mm",
          "type": "number"
        }
      },
      "required": [
        "x_mm",
        "y_mm",
        "width_mm",
        "height_mm"
      ],
      "title": "BoundsMM",
      "type": "object"
    },
    "ClosePath": {
      "additionalProperties": false,
      "properties": {
        "cmd": {
          "const": "Z",
          "default": "Z",
          "title": "Cmd",
          "type": "string"
        }
      },
      "title": "ClosePath",
      "type": "object"
    },
    "CubicTo": {
      "additionalProperties": false,
      "properties": {
        "cmd": {
          "const": "C",
          "default": "C",
          "title": "Cmd",
          "type": "string"
        },
        "control1": {
          "$ref": "#/$defs/PointMM"
        },
        "control2": {
          "$ref": "#/$defs/PointMM"
        },
        "p": {
          "$ref": "#/$defs/PointMM"
        }
      },
      "required": [
        "control1",
        "control2",
        "p"
      ],
      "title": "CubicTo",
      "type": "object"
    },
    "ExtractedVisualElement": {
      "additionalProperties": false,
      "properties": {
        "concept_node_id": {
          "title": "Concept Node Id",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "mapped_asset_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mapped Asset Id"
        },
        "mapped_layer_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mapped Layer Id"
        },
        "mapping_confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Mapping Confidence",
          "type": "number"
        }
      },
      "required": [
        "id",
        "concept_node_id",
        "mapping_confidence"
      ],
      "title": "ExtractedVisualElement",
      "type": "object"
    },
    "GroupLayer": {
      "additionalProperties": false,
      "properties": {
        "blend_mode": {
          "$ref": "#/$defs/BlendMode",
          "default": "normal"
        },
        "bounds": {
          "$ref": "#/$defs/BoundsMM"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "layer_type": {
          "const": "group",
          "default": "group",
          "title": "Layer Type",
          "type": "string"
        },
        "member_layer_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Member Layer Ids",
          "type": "array"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "opacity": {
          "default": 1.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Opacity",
          "type": "number"
        },
        "owner_skill_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Owner Skill Id"
        },
        "semantic_role": {
          "title": "Semantic Role",
          "type": "string"
        },
        "visible": {
          "default": true,
          "title": "Visible",
          "type": "boolean"
        },
        "z_index": {
          "title": "Z Index",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "name",
        "semantic_role",
        "z_index",
        "bounds",
        "member_layer_ids"
      ],
      "title": "GroupLayer",
      "type": "object"
    },
    "ImageLayer": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
