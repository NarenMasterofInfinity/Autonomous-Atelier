{
  "$defs": {
    "AssetType": {
      "enum": [
        "raster",
        "vector",
        "mask",
        "text_path",
        "composite"
      ],
      "title": "AssetType",
      "type": "string"
    },
    "CompositeOutputSpec": {
      "additionalProperties": false,
      "properties": {
        "editable_layer_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Editable Layer Ids",
          "type": "array"
        },
        "kind": {
          "const": "composite",
          "default": "composite",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "editable_layer_ids"
      ],
      "title": "CompositeOutputSpec",
      "type": "object"
    },
    "MaskOutputSpec": {
      "additionalProperties": false,
      "properties": {
        "height_px": {
          "exclusiveMinimum": 0,
          "title": "Height Px",
          "type": "integer"
        },
        "kind": {
          "const": "mask",
          "default": "mask",
          "title": "Kind",
          "type": "string"
        },
        "width_px": {
          "exclusiveMinimum": 0,
          "title": "Width Px",
          "type": "integer"
        }
      },
      "required": [
        "width_px",
        "height_px"
      ],
      "title": "MaskOutputSpec",
      "type": "object"
    },
    "NormalizedRegion": {
      "additionalProperties": false,
      "properties": {
        "height": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Height",
          "type": "number"
        },
        "width": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Width",
          "type": "number"
        },
        "x": {
          "maximum": 1,
          "minimum": 0,
          "title": "X",
          "type": "number"
        },
        "y": {
          "maximum": 1,
          "minimum": 0,
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "title": "NormalizedRegion",
      "type": "object"
    },
    "RasterOutputSpec": {
      "additionalProperties": false,
      "properties": {
        "alpha_required": {
          "default": false,
          "title": "Alpha Required",
          "type": "boolean"
        },
        "height_px": {
          "exclusiveMinimum": 0,
          "title": "Height Px",
          "type": "integer"
        },
        "kind": {
          "const": "raster",
          "default": "raster",
          "title": "Kind",
          "type": "string"
        },
        "width_px": {
          "exclusiveMinimum": 0,
          "title": "Width Px",
          "type": "integer"
        }
      },
      "required": [
        "width_px",
        "height_px"
      ],
      "title": "RasterOutputSpec",
      "type": "object"
    },
    "TextPathOutputSpec": {
      "additionalProperties": false,
      "properties": {
        "format": {
          "const": "svg",
          "default": "svg",
          "title": "Format",
          "type": "string"
        },
        "kind": {
          "const": "text_path",
          "default": "text_path",
          "title": "Kind",
          "type": "string"
        }
      },
      "title": "TextPathOutputSpec",
      "type": "object"
    },
    "VectorOutputSpec": {
      "additionalProperties": false,
      "properties": {
        "editable_paths_required": {
          "default": true,
          "title": "Editable Paths Required",
          "type": "boolean"
        },
        "format": {
          "const": "svg",
          "default": "svg",
          "title": "Format",
          "type": "string"
        },
        "kind": {
          "const": "vector",
          "default": "vector",
          "title": "Kind",
          "type": "string"
        }
      },
      "title": "VectorOutputSpec",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "asset_type": {
      "$ref": "#/$defs/AssetType"
    },
    "color_constraints": {
      "items": {
        "type": "string"
      },
      "title": "Color Constraints",
      "type": "array"
    },
    "generation_spec": {
      "title": "Generation Spec",
      "type": "string"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "integration_method": {
      "enum": [
        "clipping",
        "masking",
        "blending",
        "direct"
      ],
      "title": "Integration Method",
      "type": "string"
    },
    "output": {
      "discriminator": {
        "mapping": {
          "composite": "#/$defs/CompositeOutputSpec",
          "mask": "#/$defs/MaskOutputSpec",
          "raster": "#/$defs/RasterOutputSpec",
          "text_path": "#/$defs/TextPathOutputSpec",
          "vector": "#/$defs/VectorOutputSpec"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/RasterOutputSpec"
        },
        {
          "$ref": "#/$defs/VectorOutputSpec"
        },
        {
          "$ref": "#/$defs/MaskOutputSpec"
        },
        {
          "$ref": "#/$defs/TextPathOutputSpec"
        },
        {
          "$ref": "#/$defs/CompositeOutputSpec"
        }
      ],
      "title": "Output"
    },
    "preferred_generation_method": {
      "title": "Preferred Generation Method",
      "type": "string"
    },
    "provenance_notes": {
      "title": "Provenance Notes",
      "type": "string"
    },
    "target_layer_dependency_id": {
      "title": "Target Layer Dependency Id",
      "type": "string"
    },
    "target_region": {
      "$ref": "#/$defs/NormalizedRegion"
    },
    "visual_acceptance_checks": {
      "items": {
        "type": "string"
      },
      "title": "Visual Acceptance Checks",
      "type": "array"
    },
    "visual_role": {
      "title": "Visual Role",
      "type": "string"
    }
  },
  "required": [
    "id",
    "asset_type",
    "visual_role",
    "generation_spec",
    "target_region",
    "color_constraints",
    "preferred_generation_method",
    "target_layer_dependency_id",
    "integration_method",
    "output",
    "provenance_notes"
  ],
  "title": "ArtifactRequest",
  "type": "object"
}
