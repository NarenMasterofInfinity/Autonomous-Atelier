{
  "$defs": {
    "AnchorRelationship": {
      "additionalProperties": false,
      "properties": {
        "offset_mm": {
          "default": 0.0,
          "title": "Offset Mm",
          "type": "number"
        },
        "relationship_type": {
          "enum": [
            "behind",
            "above",
            "align_left",
            "align_center",
            "overlaps",
            "wrap_around",
            "avoid"
          ],
          "title": "Relationship Type",
          "type": "string"
        },
        "source_layer_id": {
          "title": "Source Layer Id",
          "type": "string"
        },
        "target_layer_id": {
          "title": "Target Layer Id",
          "type": "string"
        }
      },
      "required": [
        "source_layer_id",
        "target_layer_id",
        "relationship_type"
      ],
      "title": "AnchorRelationship",
      "type": "object"
    },
    "ClosePath": {
      "additionalProperties": false,
      "properties": {
        "cmd": {
          "const": "Z",
          "default": "Z",
          "title": "Cmd",
          "type": "string"
        }
      },
      "title": "ClosePath",
      "type": "object"
    },
    "CubicTo": {
      "additionalProperties": false,
      "properties": {
        "cmd": {
          "const": "C",
          "default": "C",
          "title": "Cmd",
          "type": "string"
        },
        "control1": {
          "$ref": "#/$defs/PointMM"
        },
        "control2": {
          "$ref": "#/$defs/PointMM"
        },
        "p": {
          "$ref": "#/$defs/PointMM"
        }
      },
      "required": [
        "control1",
        "control2",
        "p"
      ],
      "title": "CubicTo",
      "type": "object"
    },
    "LineTo": {
      "additionalProperties": false,
      "properties": {
        "cmd": {
          "const": "L",
          "default": "L",
          "title": "Cmd",
          "type": "string"
        },
        "p": {
          "$ref": "#/$defs/PointMM"
        }
      },
      "required": [
        "p"
      ],
      "title": "LineTo",
      "type": "object"
    },
    "MoveTo": {
      "additionalProperties": false,
      "properties": {
        "cmd": {
          "const": "M",
          "default": "M",
          "title": "Cmd",
          "type": "string"
        },
        "p": {
          "$ref": "#/$defs/PointMM"
        }
      },
      "required": [
        "p"
      ],
      "title": "MoveTo",
      "type": "object"
    },
    "PathGeometry": {
      "additionalProperties": false,
      "properties": {
        "commands": {
          "items": {
            "discriminator": {
              "mapping": {
                "C": "#/$defs/CubicTo",
                "L": "#/$defs/LineTo",
                "M": "#/$defs/MoveTo",
                "Q": "#/$defs/QuadraticTo",
                "Z": "#/$defs/ClosePath"
              },
              "propertyName": "cmd"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/MoveTo"
              },
              {
                "$ref": "#/$defs/LineTo"
              },
              {
                "$ref": "#/$defs/QuadraticTo"
              },
              {
                "$ref": "#/$defs/CubicTo"
              },
              {
                "$ref": "#/$defs/ClosePath"
              }
            ]
          },
          "minItems": 2,
          "title": "Commands",
          "type": "array"
        },
        "fill_rule": {
          "default": "nonzero",
          "enum": [
            "nonzero",
            "evenodd"
          ],
          "title": "Fill Rule",
          "type": "string"
        }
      },
      "required": [
        "commands"
      ],
      "title": "PathGeometry",
      "type": "object"
    },
    "PointMM": {
      "additionalProperties": false,
      "properties": {
        "x_mm": {
          "title": "X Mm",
          "type": "number"
        },
        "y_mm": {
          "title": "Y Mm",
          "type": "number"
        }
      },
      "required": [
        "x_mm",
        "y_mm"
      ],
      "title": "PointMM",
      "type": "object"
    },
    "QuadraticTo": {
      "additionalProperties": false,
      "properties": {
        "cmd": {
          "const": "Q",
          "default": "Q",
          "title": "Cmd",
          "type": "string"
        },
        "control": {
          "$ref": "#/$defs/PointMM"
        },
        "p": {
          "$ref": "#/$defs/PointMM"
        }
      },
      "required": [
        "control",
        "p"
      ],
      "title": "QuadraticTo",
      "type": "object"
    },
    "RuleBreakJustification": {
      "additionalProperties": false,
      "properties": {
        "justification": {
          "title": "Justification",
          "type": "string"
        },
        "rule": {
          "title": "Rule",
          "type": "string"
        }
      },
      "required": [
        "rule",
        "justification"
      ],
      "title": "RuleBreakJustification",
      "type": "object"
    },
    "SpatialMode": {
      "enum": [
        "semantic",
        "guided",
        "freeform"
      ],
      "title": "SpatialMode",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "anchor_relationships": {
      "items": {
        "$ref": "#/$defs/AnchorRelationship"
      },
      "title": "Anchor Relationships",
      "type": "array"
    },
    "custom_paths": {
      "items": {
        "$ref": "#/$defs/PathGeometry"
      },
      "title": "Custom Paths",
      "type": "array"
    },
    "mode": {
      "$ref": "#/$defs/SpatialMode"
    },
    "primary_solver": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Primary Solver"
    },
    "rule_breaks": {
      "items": {
        "$ref": "#/$defs/RuleBreakJustification"
      },
      "title": "Rule Breaks",
      "type": "array"
    }
  },
  "required": [
    "mode"
  ],
  "title": "SpatialIntent",
  "type": "object"
}
