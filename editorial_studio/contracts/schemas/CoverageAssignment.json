{
  "$defs": {
    "CoverageStatus": {
      "enum": [
        "unassigned",
        "placed",
        "deferred",
        "omitted_approved"
      ],
      "title": "CoverageStatus",
      "type": "string"
    },
    "SourceSpan": {
      "additionalProperties": false,
      "properties": {
        "end_char": {
          "exclusiveMinimum": 0,
          "title": "End Char",
          "type": "integer"
        },
        "source_block_id": {
          "title": "Source Block Id",
          "type": "string"
        },
        "source_revision_id": {
          "title": "Source Revision Id",
          "type": "string"
        },
        "start_char": {
          "minimum": 0,
          "title": "Start Char",
          "type": "integer"
        }
      },
      "required": [
        "source_block_id",
        "source_revision_id",
        "start_char",
        "end_char"
      ],
      "title": "SourceSpan",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "approval_actor": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Approval Actor"
    },
    "assigned_spread_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Assigned Spread Id"
    },
    "reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reason"
    },
    "span": {
      "$ref": "#/$defs/SourceSpan"
    },
    "status": {
      "$ref": "#/$defs/CoverageStatus"
    }
  },
  "required": [
    "span",
    "status"
  ],
  "title": "CoverageAssignment",
  "type": "object"
}
