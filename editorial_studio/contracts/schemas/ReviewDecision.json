{
  "$defs": {
    "CriticVerdict": {
      "enum": [
        "ACCEPT",
        "REVISE",
        "RECOMPOSE",
        "RECONCEPT",
        "REPLAN"
      ],
      "title": "CriticVerdict",
      "type": "string"
    },
    "CritiqueFinding": {
      "additionalProperties": false,
      "properties": {
        "actionable_fix": {
          "title": "Actionable Fix",
          "type": "string"
        },
        "category": {
          "title": "Category",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "target_layer_ids": {
          "items": {
            "type": "string"
          },
          "title": "Target Layer Ids",
          "type": "array"
        }
      },
      "required": [
        "category",
        "severity",
        "description",
        "actionable_fix"
      ],
      "title": "CritiqueFinding",
      "type": "object"
    },
    "RuleBreakEvaluation": {
      "additionalProperties": false,
      "properties": {
        "accepted": {
          "title": "Accepted",
          "type": "boolean"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "rule": {
          "title": "Rule",
          "type": "string"
        }
      },
      "required": [
        "rule",
        "accepted",
        "reason"
      ],
      "title": "RuleBreakEvaluation",
      "type": "object"
    },
    "Severity": {
      "enum": [
        "CRITICAL",
        "HIGH",
        "MEDIUM",
        "LOW"
      ],
      "title": "Severity",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "artistic_findings": {
      "items": {
        "$ref": "#/$defs/CritiqueFinding"
      },
      "title": "Artistic Findings",
      "type": "array"
    },
    "concept_fidelity_findings": {
      "items": {
        "$ref": "#/$defs/CritiqueFinding"
      },
      "title": "Concept Fidelity Findings",
      "type": "array"
    },
    "execution_findings": {
      "items": {
        "$ref": "#/$defs/CritiqueFinding"
      },
      "title": "Execution Findings",
      "type": "array"
    },
    "rule_break_evaluations": {
      "items": {
        "$ref": "#/$defs/RuleBreakEvaluation"
      },
      "title": "Rule Break Evaluations",
      "type": "array"
    },
    "stagnation_detected": {
      "default": false,
      "title": "Stagnation Detected",
      "type": "boolean"
    },
    "target_edit_instructions": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Target Edit Instructions"
    },
    "verdict": {
      "$ref": "#/$defs/CriticVerdict"
    }
  },
  "required": [
    "verdict",
    "execution_findings",
    "artistic_findings",
    "concept_fidelity_findings",
    "rule_break_evaluations"
  ],
  "title": "ReviewDecision",
  "type": "object"
}
