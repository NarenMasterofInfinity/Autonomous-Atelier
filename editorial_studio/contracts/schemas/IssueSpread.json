          "title": "Composition Mandate",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "left_page": {
          "maximum": 12,
          "minimum": 1,
          "title": "Left Page",
          "type": "integer"
        },
        "narrative_goal": {
          "minLength": 1,
          "title": "Narrative Goal",
          "type": "string"
