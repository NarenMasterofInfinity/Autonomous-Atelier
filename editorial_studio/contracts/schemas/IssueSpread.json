          "type": "string"
        },
        "right_page": {
          "maximum": 12,
          "minimum": 1,
          "title": "Right Page",
          "type": "integer"
        },
        "story_id": {
          "title": "Story Id",
          "type": "string"
        },
        "visual_energy": {
          "maximum": 5,
          "minimum": 1,
          "title": "Visual Energy",
          "type": "integer"
        },
        "visual_metaphor": {
          "minLength": 1,
          "title": "Visual Metaphor",
          "type": "string"
        }
